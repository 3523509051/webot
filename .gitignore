# 敏感配置
.env
.env.*
!.env.example

# 运行数据（含登录态、数据库）
data/

# 备份
*.bak
*.bak-*
scripts/_*
scripts/local/
*.tar.gz
backup-*

# 记忆导出（含群聊内容与群成员画像，属运行数据，禁止入库）
docs/memory-export-*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / OS
.idea/
.vscode/
.DS_Store

# 运行时产物（含群名/昵称/聊天里的表情图，不该进仓库）
# ⚠️ 注意：.gitignore **不支持行尾注释** —— 注释必须单独一行，否则整行会被当成模式匹配不到
bridge/config.json
bridge/*.log
bridge/*.log.*
bridge/cache/
logs/
wechatauto_logs/

# 本地表情库（图片和 manifest 是运行数据）
stickers/files/
stickers/index.json
stickers/*.tmp
stickers/*.broken-*.json

# 本地文件库（群文件是运行数据）
files/files/
files/index.json
files/*.tmp
files/*.broken-*.json

# 微信数据库密钥缓存（正常情况下在 %TEMP%，兜底忽略）
keys.json
*keys*.json

# 虚拟显示器驱动工具（Surface 部署不需要，可选上传）
tools/vdd/
Thumbs.db

# 本地交接、部署暂存与界面原型，不作为公开源码发布
/交流/
/access_stage/
/f05-stage/
/private-ui-stage/
/*.stage.*
/打开Pero控制室.ps1
/bridge/BRIDGE_IMPLEMENTATION_GUIDE.md
/bridge/PRIVATE_*.md
/bridge/probe_private.py
/docs/engineering-map.*
/docs/diagrams/
/docs/pero-execution-plan.md
data-*/
*.dpapi
*.db
*.db-*
*.sqlite
