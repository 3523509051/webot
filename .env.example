# ============================================
# 微信 AGI 群聊助手 · 环境变量模板
# 用法（复制为 .env 后按需修改）：
#   Windows:  copy .env.example .env
#   Linux  :  cp   .env.example .env
# .env 已被 .gitignore 忽略，切勿提交。
#
# ⚠️ LLM 的 API Key **不在这里** ——
#    在 AstrBot WebUI（http://localhost:6185）→ 服务提供商 里配置。
# ============================================

# 时区
TZ=Asia/Shanghai

# 端口（改了要和 AstrBot 面板里的平台配置一致）
ASTRBOT_WEB_PORT=6185     # WebUI 管理面板
ONEBOT_WS_PORT=6199       # OneBot v11 反向 WS（bridge 连这里）
